# OpenRouter API Key (Бесплатные модели deepseek/deepseek-chat:free и deepseek/deepseek-r1:free)
# Получить бесплатный ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Либо официальный DeepSeek API Key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Либо Groq API Key (https://console.groq.com)
GROQ_API_KEY=
