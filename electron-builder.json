{
  "appId": "com.dndaie5.app",
  "productName": "DnDAIe5",
  "copyright": "Copyright © 2026 Nikit04k",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "asar": false,
  "files": [
    "**/*",
    "!android/**/*",
    "!capacitor.config.ts",
    "!.git/**/*",
    "!dist/**/*",
    "!out/**/*",
    "!tmp_audio/**/*",
    "!tools/**/*",
    "!scripts/**/*",
    "!*.tsbuildinfo",
    "!*.log"
  ],
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.png",
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "DnDAIe5 AI DM & Party RPG",
    "uninstallDisplayName": "DnDAIe5",
    "deleteAppDataOnUninstall": false
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}.${ext}",
    "splashImage": "build/splash.bmp",
    "requestExecutionLevel": "user"
  }
}
