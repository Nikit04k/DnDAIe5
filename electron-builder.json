{
  "appId": "com.dndaie5.app",
  "productName": "DnDAIe5",
  "copyright": "Copyright © 2026 Nikit04k",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "compression": "maximum",
  "asar": true,
  "asarUnpack": [
    "node_modules/msedge-tts/**/*",
    "node_modules/ws/**/*"
  ],
  "electronLanguages": ["ru", "en-US", "en"],
  "files": [
    "**/*",
    "!.git/**/*",
    "!dist/**/*",
    "!out/**/*",
    "!build/**/*",
    "!assets/**/*",
    "!tools/**/*",
    "!scripts/**/*",
    "!tmp_audio/**/*",
    "!**/.next/cache/**/*",
    "!**/.next/diagnostics/**/*",
    "!**/.next/trace",
    "!types/**/*",
    "!tsconfig*.json",
    "!postcss.config.mjs",
    "!tailwind.config.ts",
    "!README.md",
    "!DIFFICULTY_PROMPTS.md",
    "!DND_AI_GM_COMMANDS.txt",
    "!.env.example",
    "!*.tsbuildinfo",
    "!*.log",
    "!**/*.map",
    "!node_modules/@next/swc*/**/*",
    "!node_modules/@img/**/*",
    "!node_modules/typescript/**/*",
    "!node_modules/lucide-react/**/*",
    "!node_modules/electron-winstaller/**/*",
    "!node_modules/tailwindcss/**/*",
    "!node_modules/app-builder-lib/**/*",
    "!node_modules/@types/**/*",
    "!node_modules/node-gyp/**/*",
    "!node_modules/electron/**/*",
    "!node_modules/postcss/**/*",
    "!node_modules/**/.bin/**/*",
    "!node_modules/**/docs/**/*",
    "!node_modules/**/examples/**/*",
    "!node_modules/**/*.md",
    "!node_modules/**/*.txt",
    "!node_modules/**/test/**/*",
    "!node_modules/**/tests/**/*",
    "!node_modules/**/__tests__/**/*",
    "!node_modules/**/benchmark/**/*"
  ],
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.png",
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "DnDAIe5 AI DM & Party RPG",
    "uninstallDisplayName": "DnDAIe5",
    "deleteAppDataOnUninstall": false
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}.${ext}",
    "splashImage": "build/splash.bmp",
    "requestExecutionLevel": "user"
  }
}
