{
  "name": "dnd-ai-5e",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "dev:next": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "node server.js",
    "start:next": "next start -H 0.0.0.0 -p 3000",
    "lan:ws": "node server/lanServer.js",
    "electron": "electron electron/main.js",
    "electron:dev": "cross-env NODE_ENV=development electron electron/main.js",
    "dist:win": "npm run build && electron-builder --win --x64",
    "cap:build": "node scripts/buildMobile.js && npx cap sync android",
    "cap:sync": "npx cap sync android",
    "build:apk": "npm run cap:build && cd android && powershell -Command \"$env:JAVA_HOME = if (Test-Path 'C:\\Program Files\\Java\\jdk-21.0.11') { 'C:\\Program Files\\Java\\jdk-21.0.11' } else { $env:JAVA_HOME }; .\\gradlew.bat assembleDebug\" && node -e \"require('fs').copyFileSync('app/build/outputs/apk/debug/app-debug.apk', '../dist/DnDAIe5-Mobile.apk')\"",
    "lint": "next lint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "msedge-tts": "^2.0.7",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
